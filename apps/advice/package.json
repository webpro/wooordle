{
  "name": "@wooordle/advice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts --debug",
    "dev:client": "vite",
    "build": "podman build -f ../../Dockerfile -t wooordle-advice ../..",
    "build:client": "vite build",
    "type-check": "tsc",
    "deploy": "pnpm build:client && pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@hono/node-server": "^2.1.1",
    "@wooordle/ocr": "workspace:*",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.133.0"
  }
}
