{
  "name": "@wooordle/advice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts --debug",
    "dev:client": "vite",
    "build": "podman build -f ../../Dockerfile -t wooordle-advice ../..",
    "build:client": "vite build",
    "test": "node --test scripts/deploy.spec.mjs",
    "type-check": "tsc",
    "deploy": "pnpm build:client && pnpm build --platform linux/amd64 && node scripts/deploy.mjs wooordle-advice"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@hono/node-server": "^2.1.5",
    "@wooordle/ocr": "workspace:*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  }
}
